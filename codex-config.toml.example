# Project-scope file: <project>/.codex/config.toml
# Read only when the agent is started from that project directory.

[mcp_servers.jira]
command = "uvx"
args = [
    "mcp-atlassian",
    "--env-file",
    "/Users/you/.config/atlassian-mcp/atlassian.env",
]

[mcp_servers.jira.env]
# "default" already includes Confluence pages and comments.
TOOLSETS = "default,jira_agile,jira_links,jira_worklog"
READ_ONLY_MODE = "false"
