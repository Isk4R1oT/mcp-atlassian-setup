# Copy to ~/.config/atlassian-mcp/atlassian.env, then: chmod 600 <that file>
# Never commit the filled-in copy. This template contains no real values.
#
# The mcp-atlassian server reads this file directly when started with
#   uvx mcp-atlassian --env-file /path/to/atlassian.env
# so the shell that launches the agent does not need to export anything.

# --- Jira -------------------------------------------------------------------

# Base URL, no trailing slash, no /rest suffix.
export JIRA_URL="https://jira.example.com"

# Personal access token: Jira -> Profile -> Personal Access Tokens -> Create.
export JIRA_PERSONAL_TOKEN="replace-me"

# Only needed for Atlassian Cloud (basic auth with email + API token).
# Not used by Server/Data Center PAT auth; harmless if left unset.
# export JIRA_USERNAME="you@example.com"

# --- Confluence -------------------------------------------------------------

# Confluence is a separate application with its own token. A Jira token
# pasted here returns 401.
export CONFLUENCE_URL="https://confluence.example.com"
export CONFLUENCE_PERSONAL_TOKEN="replace-me"

# --- Optional ---------------------------------------------------------------

# Self-signed certificate only. Prefer installing the CA.
# export JIRA_SSL_VERIFY="true"
# export CONFLUENCE_SSL_VERIFY="true"

# Space-separated. Restricts Confluence to these spaces; empty means all.
# export CONFLUENCE_SPACES_FILTER=""
